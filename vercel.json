{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "site/api/config.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    },
    {
      "src": "site/api/contact.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    },
    {
      "src": "site/api/wholesale.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/site/api/config.ts" },
    { "src": "/api/contact", "dest": "/site/api/contact.ts" },
    { "src": "/api/wholesale", "dest": "/site/api/wholesale.ts" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}