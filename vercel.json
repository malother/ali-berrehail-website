{
  "version": 2,
  "builds": [
    {
      "src": "site/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "build": "VERCEL=1 npm run build && rm -rf ../dist && cp -r dist ../dist"
      }
    },
    {
      "src": "site/api/config.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    },
    {
      "src": "site/api/contact.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    },
    {
      "src": "site/api/wholesale.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/site/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
