# Sensitive files — do NOT deploy to Vercel
config.json
opencode.json
.env.local

# Local server files (not needed on Vercel)
server.ps1
start.bat
run_server.cmd

# Local data (user submissions) — root-level only, preserves site/src/data/
/data/

# Root-level build output (from local dev) — preserves site/public/ and site/dist/
/public/

# Root-level Vercel build output (generated by `VERCEL=1 vite build`)
/dist/

# Source maps and logs
*.map
*.log

# Node artifacts
node_modules/
site/node_modules/

# Utility scripts
check_site.ps1
